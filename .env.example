# Voice Builder — environment template.
# Copy this file to `.env.local` (gitignored) and fill in real values.
# NEVER paste real API keys into this file — it's tracked by git.

# ---------------------------------------------------------------------------
# OpenAI — Step 1 prefill (drafting a bot from a description)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
# Override the model identifier if needed (default: gpt-5.5)
# OPENAI_MODEL=gpt-5.5
# Override the API base URL (e.g. for Azure OpenAI)
# OPENAI_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------------------------
# ElevenLabs — voice previews in the wizard
# ---------------------------------------------------------------------------
ELEVENLABS_API_KEY=
# Override the TTS model (default: eleven_turbo_v2_5)
# ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# ---------------------------------------------------------------------------
# Retell — deploys the AI receptionist (LLM + agent + phone import)
# ---------------------------------------------------------------------------
RETELL_API_KEY=
# RETELL_API_BASE=https://api.retellai.com

# ---------------------------------------------------------------------------
# Twilio — number search/buy + SIP trunk linking to Retell
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Regulatory Address SIDs (per country). Some countries (notably GB) require
# a verified business address before any local/mobile number can be bought.
# Create the address in Twilio Console -> Phone Numbers -> Regulatory
# Compliance -> Addresses, then paste the resulting SID (starts with AD).
TWILIO_DEFAULT_ADDRESS_SID_GB=
TWILIO_DEFAULT_ADDRESS_SID_US=
TWILIO_DEFAULT_ADDRESS_SID_CA=

# Regulatory Bundle SIDs (per country). Some number types in the UK and
# elsewhere additionally need a Regulatory Bundle proving business identity.
# Create in Twilio Console -> Regulatory Compliance -> Bundles.
TWILIO_DEFAULT_BUNDLE_SID_GB=
TWILIO_DEFAULT_BUNDLE_SID_US=
TWILIO_DEFAULT_BUNDLE_SID_CA=

# ---------------------------------------------------------------------------
# Supabase — auth + database (per-agency multi-tenant; tables in `vb` schema)
# ---------------------------------------------------------------------------
# Project URL + Publishable (or anon) key are safe in the browser.
# Service role / secret key is server-only — never expose.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Default agency slug used when a request can't be resolved via Host header.
# Required for local dev (localhost:3000 doesn't match any custom_domain).
DEFAULT_AGENCY_SLUG=

# ---------------------------------------------------------------------------
# Resend — magic-link emails sent per-agency from their branded domain
# ---------------------------------------------------------------------------
RESEND_API_KEY=

# ---------------------------------------------------------------------------
# Stripe — subscription payments + Connect Express for agency payouts
# ---------------------------------------------------------------------------
# Secret key: sk_test_… in dev, sk_live_… in production.
STRIPE_SECRET_KEY=

# Webhook signing secret. In dev, generated by `stripe listen`.
# In production, set in Stripe Dashboard -> Webhooks.
STRIPE_WEBHOOK_SECRET=

# Subscription price ID (£99/mo). Create one in Stripe Dashboard -> Products,
# then paste the `price_…` value here.
STRIPE_PRICE_ID=

# ---------------------------------------------------------------------------
# App URL — used in transactional emails (e.g. "Update card" button)
# In dev this is auto-detected; set explicitly in production.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_APP_URL=https://builder.macaws.ai
