# Voice Builder — environment template.
# Copy this file to `.env.local` (gitignored) and fill in real values.
# NEVER paste real API keys into this file — it's tracked by git.

# ---------------------------------------------------------------------------
# OpenAI — Step 1 prefill (drafting a bot from a description)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
# Override the model identifier if needed (default: gpt-5.5)
# OPENAI_MODEL=gpt-5.5
# Override the API base URL (e.g. for Azure OpenAI)
# OPENAI_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------------------------
# ElevenLabs — voice previews in the wizard
# ---------------------------------------------------------------------------
ELEVENLABS_API_KEY=
# Override the TTS model (default: eleven_turbo_v2_5)
# ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# ---------------------------------------------------------------------------
# Retell — deploys the AI receptionist (LLM + agent + phone import)
# ---------------------------------------------------------------------------
RETELL_API_KEY=
# RETELL_API_BASE=https://api.retellai.com

# ---------------------------------------------------------------------------
# Twilio — number search/buy + SIP trunk linking to Retell
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Regulatory Address SIDs (per country). Some countries (notably GB) require
# a verified business address before any local/mobile number can be bought.
# Create the address in Twilio Console -> Phone Numbers -> Regulatory
# Compliance -> Addresses, then paste the resulting SID (starts with AD).
TWILIO_DEFAULT_ADDRESS_SID_GB=
TWILIO_DEFAULT_ADDRESS_SID_US=
TWILIO_DEFAULT_ADDRESS_SID_CA=

# Regulatory Bundle SIDs (per country). Some number types in the UK and
# elsewhere additionally need a Regulatory Bundle proving business identity.
# Create in Twilio Console -> Regulatory Compliance -> Bundles.
TWILIO_DEFAULT_BUNDLE_SID_GB=
TWILIO_DEFAULT_BUNDLE_SID_US=
TWILIO_DEFAULT_BUNDLE_SID_CA=

# ---------------------------------------------------------------------------
# Supabase — auth + database (per-agency multi-tenant; tables in `vb` schema)
# ---------------------------------------------------------------------------
# Project URL + Publishable (or anon) key are safe in the browser.
# Service role / secret key is server-only — never expose.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Default agency slug used when a request can't be resolved via Host header.
# Required for local dev (localhost:3000 doesn't match any custom_domain).
DEFAULT_AGENCY_SLUG=

# ---------------------------------------------------------------------------
# Resend — magic-link emails sent per-agency from their branded domain
# ---------------------------------------------------------------------------
RESEND_API_KEY=

# ---------------------------------------------------------------------------
# GoHighLevel — transactional email (primary transport when configured)
# ---------------------------------------------------------------------------
# Platform-wide fallback. Per-agency values on vb.agencies
# (ghl_location_id / ghl_api_token) take precedence when set.
#
# Location ID: GHL sub-account → Settings → Business Profile → Location ID.
# API token:   GHL sub-account → Settings → Private Integrations →
#              create a new integration with scopes:
#                contacts.write, contacts.readonly,
#                conversations/message.write, conversations.write
GHL_LOCATION_ID=
GHL_API_TOKEN=

# ---------------------------------------------------------------------------
# Stripe — subscription payments + Connect Express for agency payouts
# ---------------------------------------------------------------------------
# Secret key: sk_test_… in dev, sk_live_… in production.
STRIPE_SECRET_KEY=

# Webhook signing secret for PLATFORM events (destination-charge subs,
# account.updated). In dev, generated by `stripe listen`. In production,
# set in Stripe Dashboard → Developers → Webhooks → your platform endpoint.
STRIPE_WEBHOOK_SECRET=

# Webhook signing secret for CONNECT events (direct-charge subs running on
# connected accounts). Configure a separate webhook endpoint in Stripe
# Dashboard → Developers → Webhooks → "Add endpoint" → "Events on Connected
# accounts" → point at /api/webhooks/stripe-connect. Paste the signing
# secret here. Required once any agency has use_direct_charges = true.
STRIPE_CONNECT_WEBHOOK_SECRET=

# Subscription Product ID. Used ONLY in destination-charge mode (legacy /
# platform path). Direct-charge agencies use inline product_data so no
# per-agency Product needs to exist on the connected account. Create one
# in Stripe Dashboard → Products and paste the `prod_…` value here. If
# unset, the destination-charge path returns an error; direct-charge
# checkouts are unaffected.
STRIPE_PRODUCT_ID=

# ---------------------------------------------------------------------------
# App URL — used in transactional emails (e.g. "Update card" button)
# In dev this is auto-detected; set explicitly in production.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_APP_URL=https://builder.macaws.ai

# ---------------------------------------------------------------------------
# Marketing region — drives the regional copy on the public marketing pages
# (homepage, /pricing, /how-it-works, /faq). Each agency runs on its own
# Vercel deployment, so this is set per-deploy. Affects:
#   - country adjective ("UK number" vs "US number")
#   - voice language label ("UK English" vs "US English")
#   - area code city examples
#   - industry example used in hero copy
#   - representative competing-service prices in the comparison table
#   - tax line under the pricing card
#
# Supported: GB, US, CA, AU, IE, NZ. Defaults to GB if unset or invalid.
# NEXT_PUBLIC_ prefix so the wizard's "Tell us about your business"
# placeholder (a client component) can read it too — value is a country
# code, no secret risk in shipping it to the browser.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_MARKETING_COUNTRY=US
